generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         AdminRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum AdminRole {
  OWNER     @map("DUEÑA")
  DEVELOPER @map("DESARROLLADOR")
}

model Imagen {
  id          Int        @id @default(autoincrement())
  nombre      String
  url         String
  publicId    String?
  servicioId  Int?
  seccion     String
  descripcion String?
  textoBoton  String?
  enlace      String?
  tipo        TipoImagen @default(GENERAL)
  orden       Int        @default(0)
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  servicio    Servicio?  @relation(fields: [servicioId], references: [id], onDelete: SetNull)

  @@index([tipo, activo])
  @@index([tipo, servicioId])
}

enum TipoImagen {
  GENERAL
  PUBLICIDAD
}

model Galeria {
  id          Int             @id @default(autoincrement())
  nombre      String
  slug        String          @unique
  descripcion String?
  orden       Int             @default(0)
  activo      Boolean         @default(true)
  servicioId  Int?            @unique
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imagenes    GaleriaImagen[]
  servicio    Servicio?       @relation(fields: [servicioId], references: [id], onDelete: SetNull)
}

model GaleriaImagen {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?
  url         String
  publicId    String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  galeriaId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  galeria     Galeria  @relation(fields: [galeriaId], references: [id], onDelete: Cascade)

  @@index([galeriaId])
}

model Servicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal? @db.Decimal(10, 2)
  imagenUrl   String?
  publicId    String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  galeria     Galeria?
  imagenes    Imagen[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Paquete {
  id              Int                     @id @default(autoincrement())
  nombre          String
  descripcion     String?
  precio          Decimal?                @db.Decimal(10, 2)
  imagenUrl       String?
  publicId        String?
  orden           Int                     @default(0)
  activo          Boolean                 @default(true)
  seccion         SeccionPaquete          @default(SESION)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  caracteristicas PaqueteCaracteristica[]
  campanias       Campania[]
}

model Campania {
  id          Int      @id @default(autoincrement())
  titulo      String   @db.VarChar(140)
  descripcion String   @db.Text
  imagenUrl   String
  publicId    String?
  inicio      DateTime @db.Timestamptz(3)
  fin         DateTime @db.Timestamptz(3)
  habilitada  Boolean  @default(false)
  paqueteId   Int
  paquete     Paquete  @relation(fields: [paqueteId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([habilitada, inicio, fin])
  @@index([paqueteId])
}

enum SeccionPaquete {
  SESION
  ALQUILER
  TARIFA
}

model PaqueteCaracteristica {
  id        Int     @id @default(autoincrement())
  nombre    String
  orden     Int     @default(0)
  paqueteId Int
  paquete   Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String
  email         String        @unique
  telefono      String?
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  membresias    Membresia[]
  reservaciones Reservacion[]
}

model PlanMembresia {
  id               Int                      @id @default(autoincrement())
  nombre           String
  descripcion      String?
  precio           Decimal                  @db.Decimal(10, 2)
  duracionDias     Int
  periodo          PeriodoPlanMembresia     @default(MENSUAL)
  limiteSesiones   Int?
  imagenUrl        String?
  publicId         String?
  activo           Boolean                  @default(true)
  archivado        Boolean                  @default(false)
  orden            Int                      @default(0)
  ubicacionPublica String                   @default("MEMBRESIAS")
  agregarInicio    Boolean                  @default(false)
  beneficios       String?
  beneficiosItems  PlanMembresiaBeneficio[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  membresias       Membresia[]
}

model PlanMembresiaBeneficio {
  id     Int           @id @default(autoincrement())
  nombre String
  orden  Int           @default(0)
  planId Int
  plan   PlanMembresia @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

enum PeriodoPlanMembresia {
  MENSUAL
  TRIMESTRAL
  ANUAL
}

model Membresia {
  id          Int             @id @default(autoincrement())
  fechaInicio DateTime        @default(now())
  fechaFin    DateTime
  estado      EstadoMembresia @default(ACTIVA)
  clienteId   Int
  planId      Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cliente     Cliente         @relation(fields: [clienteId], references: [id])
  plan        PlanMembresia   @relation(fields: [planId], references: [id])

  @@index([clienteId])
  @@index([planId])
}

model Reservacion {
  id                Int                          @id @default(autoincrement())
  nombre            String
  email             String
  telefono          String?
  tipoSesion        String
  categoriaServicio CategoriaServicioReservacion @default(SESION)
  fecha             DateTime?
  hora              String?
  mensaje           String?
  estado            EstadoReservacion            @default(PENDIENTE)
  estadoPago        EstadoPagoReservacion        @default(PENDIENTE)
  clienteId         Int?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  cliente           Cliente?                     @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([fecha])
  @@index([categoriaServicio])
}

enum CategoriaServicioReservacion {
  SESION
  ALQUILER
  TARIFA
  MEMBRESIAS
}

enum EstadoMembresia {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum EstadoReservacion {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
  COMPLETADA
}

enum EstadoPagoReservacion {
  PENDIENTE
  PAGADO
}
