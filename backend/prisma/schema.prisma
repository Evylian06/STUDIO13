generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Imagen {
  id          Int      @id @default(autoincrement())
  nombre      String
  url         String
  publicId    String?
  seccion     String
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Galeria {
  id          Int             @id @default(autoincrement())
  nombre      String
  slug        String          @unique
  descripcion String?
  orden       Int             @default(0)
  activo      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  imagenes    GaleriaImagen[]
}

model GaleriaImagen {
  id          Int      @id @default(autoincrement())
  titulo      String?
  descripcion String?
  url         String
  publicId    String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  galeriaId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  galeria     Galeria  @relation(fields: [galeriaId], references: [id], onDelete: Cascade)

  @@index([galeriaId])
}

model Servicio {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?
  precio      Decimal? @db.Decimal(10, 2)
  imagenUrl   String?
  publicId    String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Paquete {
  id              Int                     @id @default(autoincrement())
  nombre          String
  descripcion     String?
  precio          Decimal?                @db.Decimal(10, 2)
  imagenUrl       String?
  publicId        String?
  orden           Int                     @default(0)
  activo          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  caracteristicas PaqueteCaracteristica[]
}

model PaqueteCaracteristica {
  id        Int     @id @default(autoincrement())
  nombre    String
  orden     Int     @default(0)
  paqueteId Int
  paquete   Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
}

model Cliente {
  id            Int           @id @default(autoincrement())
  nombre        String
  email         String        @unique
  telefono      String?
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  membresias    Membresia[]
  reservaciones Reservacion[]
}

model PlanMembresia {
  id           Int         @id @default(autoincrement())
  nombre       String
  descripcion  String?
  precio       Decimal     @db.Decimal(10, 2)
  duracionDias Int
  activo       Boolean     @default(true)
  orden        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  membresias   Membresia[]
}

model Membresia {
  id          Int             @id @default(autoincrement())
  fechaInicio DateTime        @default(now())
  fechaFin    DateTime
  estado      EstadoMembresia @default(ACTIVA)
  clienteId   Int
  planId      Int
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  cliente     Cliente         @relation(fields: [clienteId], references: [id])
  plan        PlanMembresia   @relation(fields: [planId], references: [id])

  @@index([clienteId])
  @@index([planId])
}

model Reservacion {
  id         Int               @id @default(autoincrement())
  nombre     String
  email      String
  telefono   String?
  tipoSesion String
  fecha      DateTime
  hora       String?
  mensaje    String?
  estado     EstadoReservacion @default(PENDIENTE)
  clienteId  Int?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  cliente    Cliente?          @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([fecha])
}

enum EstadoMembresia {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum EstadoReservacion {
  PENDIENTE
  CONFIRMADA
  RECHAZADA
  CANCELADA
}
